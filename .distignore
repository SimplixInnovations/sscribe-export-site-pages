vendor-prefixed/*/composer.lock
vendor-prefixed/*/ruleset.xml

# PCLZip conflict (WordPress.org requirement)
vendor-prefixed/phpoffice/phpword/src/PhpWord/Shared/PCLZip/

# PhpWord template config — .dist extension is flagged by WordPress.org plugin-check
# scanner. Settings::loadConfig() is never called in SScribe code, so this file
# is dead weight in the dist archive. Remove it to avoid a reviewer flag.
vendor-prefixed/phpoffice/phpword/phpword.ini.dist

# Vendor-prefixed dev files (exact-name segment-level)
composer.json
.gitattributes
phpstan.neon
phpstan.neon.dist
phpstan-baseline.neon
phpunit.xml
phpunit.xml.dist
ruleset.xml
CREDITS.txt
mkdocs.yml
.travis.yml
.scrutinizer.yml
.github_changelog_generator

# Dev-only directories (segment-level — matched by build-release.php in_array check)
utils/
tmp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug files
*.log
*.tmp
*.bak
test-phpcs-output.txt

# Ad-hoc runtime verification / smoke-test scripts used during
# refactors. The PHPUnit suite covers the real assertions; these
# one-off CLI scripts must not ship in the production ZIP.
verify_*.php
debug_*.php

# Environment
.env
.env.*

# Editor / formatter config
.editorconfig
.prettierrc
.stylelintrc.json
eslint.config.js
.opencode.json

