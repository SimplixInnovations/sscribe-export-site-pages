.wp-env.json

# Infection (mutation testing)
infection.json5
infection.json5.dist

# OpenCode config
opencode.json
.opencode/

# AI tooling (Claude Code, OpenCode, Aider, Cursor, Windsurf, etc.)
# WordPress.org plugin-check flags these as "ai_instruction_directory"
# warnings if present in the production ZIP.
.claude/
.opencode/
.agent/
.aider*
.cursor/
.windsurf/
.continue/
.codeium/
.playwright-mcp/

# WP Playground scratch artifacts (local testing only — never shipped)
playground-blueprint.json
playground-tools/
.playground-tools/

# IDE / IDE assistant (stubs file used by PHPStan + Intelephense, not shipped)
.stubs/
stubs/

# Husky git hooks
.husky/

# Scratch / experimental
scratch/

# Local audit / screenshot artifacts left by browser automation.
# .audit/ holds verification screenshots; root-level .export-*.png and
# tab-export-*.{jpg,jpeg} are full-page captures from UI polish passes.
# None of this belongs in the production ZIP.
.audit/
.export-debug.png
.export-history.png
