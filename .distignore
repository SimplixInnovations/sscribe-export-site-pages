# Development files
.git/
.github/
.gitignore
.agent/

# Build & deploy
build/
deploy/
scripts/
dist/
WPScan/
WordPress-Core/
bin/

# Composer lock data is not required at runtime; composer.json remains in the
# package so WordPress.org reviewers can audit bundled dependency provenance.
composer.lock

# Testing
tests/
tests-wp/
fake-wp/
tests-e2e/
test-results/
phpunit.xml*
phpstan.neon*
phpstan-bootstrap.php
phpstan-baseline.neon
phpcs.xml*
psalm.xml
psalm.xml.dist
.php-cs-fixer.php
.php-cs-fixer.dist.php
coverage/
.phpunit.cache/

# IDE
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Node
package*.json
node_modules/

# Documentation
docs/
*.md
!readme.txt

# Raw Composer vendor tree excluded from release package
vendor/

# Local-development compatibility adapter; release code uses only prefixed vendors.
includes/sscribe-vendor-compat.php

# Vendor-prefixed extras (WordPress.org requirement)
vendor-prefixed/*/.github/
vendor-prefixed/*/.git/
# Third-party license texts ship with their source. PHPWord's original
# COPYING.LESSER name is rejected as an unexpected `.lesser` file type, so
# the release keeps the identical notice as COPYING.LESSER.txt instead.
vendor-prefixed/phpoffice/phpword/COPYING.LESSER
vendor-prefixed/*/.github_changelog_generator
vendor-prefixed/*/.php-cs-fixer*
vendor-prefixed/*/phpstan.neon*
vendor-prefixed/*/phpunit.xml*
vendor-prefixed/*/tests/
vendor-prefixed/*/docs/
vendor-prefixed/*/utils/
vendor-prefixed/*/tmp/
vendor-prefixed/*/.travis.yml
vendor-prefixed/*/.scrutinizer.yml
vendor-prefixed/*/mkdocs.yml
vendor-prefixed/*/.gitattributes
vendor-prefixed/*/.gitignore
vendor-prefixed/*/README.md
vendor-prefixed/*/CHANGELOG.md
vendor-prefixed/*/CONTRIBUTING.md
vendor-prefixed/*/CREDITS.txt
vendor-prefixed/*/composer.json
vendor-prefixed/*/composer.lock
vendor-prefixed/*/ruleset.xml

# PCLZip conflict (WordPress.org requirement)
vendor-prefixed/phpoffice/phpword/src/PhpWord/Shared/PCLZip/

# PhpWord template config — .dist extension is flagged by WordPress.org plugin-check
# scanner. Settings::loadConfig() is never called in SScribe code, so this file
# is dead weight in the dist archive. Remove it to avoid a reviewer flag.
vendor-prefixed/phpoffice/phpword/phpword.ini.dist
vendor-prefixed/phpoffice/phpword/phpmd.xml.dist

# Phase 22: dev-only root files that previously leaked into the
# release ZIP. Keep these explicit alongside the wildcard-capable matcher
# so their exclusion remains obvious in both policy and build configuration.
.superpowers
phpunit-wp.xml
playwright.config.ts

# Vendor-prefixed dev files (exact-name segment-level)
.gitattributes
phpstan.neon
phpstan.neon.dist
phpstan-baseline.neon
phpunit.xml
phpunit.xml.dist
ruleset.xml
CREDITS.txt
mkdocs.yml
.travis.yml
.scrutinizer.yml
.github_changelog_generator

# Dev-only directories (segment-level — matched by build-release.php in_array check)
utils/
tmp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug files
*.log
*.tmp
*.bak
test-phpcs-output.txt

# Ad-hoc runtime verification / smoke-test scripts used during
# refactors. The PHPUnit suite covers the real assertions; these
# one-off CLI scripts must not ship in the production ZIP.
verify_*.php
debug_*.php
# Ad-hoc Python transform scripts used during one-off SVG / kses /
# indent fixes. Shipped build never needs them; the regex passes
# that produced them are now baked into the PHP partial or CSS
# directly. Pattern-match guards against future throwaway scripts.
*.py

# Environment
.env
.env.*

# Editor / formatter config
.editorconfig
.prettierrc
.stylelintrc.json
eslint.config.js
.opencode.json

# WordPress local dev
.wp-env.json

# Infection (mutation testing)
infection.json5
infection.json5.dist

# OpenCode config
opencode.json
.opencode/

# AI tooling (Claude Code, OpenCode, Aider, Cursor, Windsurf, etc.)
# WordPress.org plugin-check flags these as "ai_instruction_directory"
# warnings if present in the production ZIP.
.claude/
.opencode/
.impeccable/
.omo/
.mimosa/
.codegraph
.agent/
.aider*
.cursor/
.windsurf/
.continue/
.codeium/
.playwright-mcp/

# WP Playground scratch artifacts (local testing only — never shipped)
playground-blueprint.json
playground-tools/
.playground-tools/
.playground-cache/

# IDE / IDE assistant (stubs file used by PHPStan + Intelephense, not shipped)
.stubs/
stubs/

# Husky git hooks
.husky/

# Scratch / experimental
scratch/

# Local browser-audit image artifacts.
# .audit/ holds verification images; root-level .export-*.png and
# tab-export-*.{jpg,jpeg} are full-page captures from UI polish passes.
# None of this belongs in the production ZIP.
.audit/
.export-debug.png
.export-history.png
.export-main.png
.export-support.png
.export-v3-final.png
export-full.png
tab-export-top.jpg
tab-export-bottom.jpg
tab-export-light.jpg
tab-export-scrolled.jpeg

# Scratch / ad-hoc audit outputs (review diffs, side-by-side comparisons,
# transient dumps). Wildcard rules are enforced by build-release.php;
# high-risk fixed filenames are also listed in base_excludes as defense in depth.
tmp_diffs/
review-diff.patch
System.Management
