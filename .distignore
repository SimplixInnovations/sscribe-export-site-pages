# Raw Composer vendor tree excluded from release package
vendor/

# Vendor-prefixed extras (WordPress.org requirement)
vendor-prefixed/*/.github/
vendor-prefixed/*/.git/
vendor-prefixed/*/COPYING*
vendor-prefixed/*/.github_changelog_generator
vendor-prefixed/*/.php-cs-fixer*
vendor-prefixed/*/phpstan.neon*
vendor-prefixed/*/phpunit.xml*
