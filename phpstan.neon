parameters:
    level: 7
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanFiles:
        # WordPress core function signatures — used for static analysis only.
        # Loaded only by PHPStan (not bundled in the production plugin).
        # The runtime plugin never includes this file; WordPress itself
        # provides the real implementations.
        - stubs/wordpress-functions.php
    paths:
        - includes
        - admin
        - sscribe-export-site-pages.php
        # Phase 25: uninstall.php is shipped in the release ZIP and runs
        # when the plugin is deleted from /wp-admin. PHPStan must analyze
        # it at the same strictness as the rest of the plugin source.
        - uninstall.php
    excludePaths:
        - vendor
    tmpDir: .cache/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Function (get_post|get_posts|get_permalink|get_the_title|get_the_content|get_post_meta|get_post_type|get_post_type_object|get_post_types|get_the_author_meta|get_post_thumbnail_id|wp_get_attachment_image_src|get_attached_file|get_the_date|get_the_modified_date|get_post_ancestors|get_children|get_term|get_object_taxonomies|get_user_by|wp_count_posts|get_current_screen|wp_list_pluck|strip_shortcodes|setup_postdata|wp_reset_postdata|maybe_unserialize) not found\.#'
        - '#Constant (PREG_OFFSET_OFFSET|ARRAY_A|OBJECT|OBJECT_K|WP_CLI) not found\.#'
        - '#Class (WP_Post|WP_Error|WP_User|WP_Query|WP_Filesystem_Base|WP_Roles) not found\.#'
        - '#Call to method .* on an unknown class WP_Filesystem_Base\.#'
        - '#Property .* has unknown class WP_Filesystem_Base as its type\.#'
        - '#Instantiated class WP_Query not found\.#'
        - '#Instantiated class WP_Roles not found\.#'
        - '#Access to property \$.+ on an unknown class WP_Roles\.#'
        - '#Access to .+ property WP_Query::\$max_num_pages#'
        - '#Function aioseo not found\.#'
        - '#Call to an undefined method DOMNode::#'
        - '#addCell\(\) expects int#'
        - '#array_map expects.*sanitize_text_field#'
        - '#array_map expects.*absint#'
        - '#array_map expects.*esc_sql#'
        - '#If condition is always true\.#'
        - '#Ternary operator condition is always true\.#'
        - '#If condition is always false\.#'
        - '#Offset .* on array on left side of \?\? always exists#'
        - '#Offset .* on non-empty-array on left side of \?\? always exists#'
        - '#Offset .* on non-empty-list on left side of \?\? always exists#'
        - '#Strict comparison using === between mixed and#'
        - '#Property .* is never read, only written\.#'
        - '#Property .* does not accept null\.#'
        - '#Function wp_add_inline_style not found\.#'
        - '#Static method .* invoked with \d+ parameters, \d+ required\.#'
        - '#Unsafe usage of new static\(\)\.#'
        - '#Method .* has invalid return type WP_Error\.#'
        - '#Instantiated class WP_Error not found\.#'
        - '#Offset.*\$format.* on left side of \?\? always exists and is not nullable\.#'
        - '#Offset.* in isset\(\) always exists and is not nullable\.#'
        # Ignore unresolvable type errors from dynamically built arrays in usort/uasort/array_values/array_slice
        - '#contains unresolvable type\.$#'
        # Ignore boolean static analysis false positives in vendor dependency check (classes exist in CI but may not in production)
        - '#Right side of \|\| is always false\.#'
        - '#Negated boolean expression is always true\.#'
        - '#Function has_action not found\.#'
        - '#Function esc_sql not found\.#'
        - '#Function (is_multisite|switch_to_blog|restore_current_blog) not found\.#'
        - '#Function (wp_timezone|wp_tempnam) not found\.#'
        # PHPStan cannot resolve private static self:: calls within same class (false positive).
        - '#Call to an undefined static method SScribe_Deactivator::cleanup_transients\(\)\.#'
        # Level 6: iterable value types for WordPress API arrays are impractical to annotate.
        - '#no value type specified in iterable type#'
        # WordPress apply_filters/do_action accept variadic args but PHPStan stubs don't reflect this.
        - '#Function (apply_filters|do_action) invoked with \d+ parameters, \d+ required\.#'
        # PHPStan evaluates constant values at analysis time — these comparisons are runtime guards.
        - '#Strict comparison using !== between .* will always evaluate to true\.#'
        - '#Strict comparison using !== between .* will always evaluate to false\.#'
        - '#Instanceof between null and .* will always evaluate to false\.#'
        # SSCRIBE_DEBUG defaults to false but can be overridden in wp-config.php. PHPStan cannot know this.
        - '#Ternary operator condition is always false\.#'
        - '#Left side of && is always false\.#'
        - '#Right side of && is always false\.#'
        - '#Result of && is always false\.#'
        - '#Left side of \|\| is always false\.#'
        # Dead code after debug guard is intentional — the code runs when SSCRIBE_DEBUG=true at runtime.
        - '#Unreachable statement - code above always terminates\.#'
