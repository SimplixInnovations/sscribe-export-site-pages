parameters:
    level: 5
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - includes
        - admin
        - sscribe-export-site-pages.php
    excludePaths:
        - vendor
    tmpDir: .cache/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Function (sanitize_text_field|wp_safe_redirect|sanitize_key|sanitize_html_class|sanitize_email|esc_html|esc_attr|esc_url|esc_url_raw|esc_js|wp_kses|wp_kses_post|wp_unslash|check_ajax_referer|current_user_can|get_option|update_option|delete_option|add_option|get_post|get_posts|get_permalink|get_the_title|get_the_content|apply_filters|do_action|add_action|add_filter|remove_action|remove_filter|plugin_dir_path|plugin_dir_url|plugin_basename|register_activation_hook|register_deactivation_hook|wp_upload_dir|wp_mkdir_p|wp_remote_get|wp_safe_remote_get|wp_remote_retrieve_body|wp_remote_retrieve_response_code|wp_remote_retrieve_header|is_wp_error|wp_json_encode|wp_send_json_success|wp_send_json_error|wp_verify_nonce|wp_create_nonce|admin_url|get_current_user_id|get_bloginfo|get_locale|esc_html__|esc_attr__|__|_e|_x|_n|load_plugin_textdomain|is_admin|wp_doing_ajax|get_post_meta|get_post_type|get_post_type_object|is_rtl|wp_next_scheduled|wp_schedule_event|wp_clear_scheduled_hook|add_menu_page|add_submenu_page|add_management_page|wp_enqueue_style|wp_enqueue_script|wp_register_style|wp_register_script|plugins_url|remove_query_arg|add_query_arg|trailingslashit|untrailingslashit|wp_generate_password|set_transient|get_transient|delete_transient|add_transient|sanitize_file_name|wp_die|wp_unschedule_event|current_time|wp_strip_all_tags|get_the_author_meta|get_post_thumbnail_id|wp_get_attachment_image_src|get_attached_file|get_the_date|get_the_modified_date|get_post_ancestors|home_url|site_url|get_children|date_i18n|size_format|wp_localize_script|checked|wp_delete_file|esc_html_e|esc_attr_e|wp_date|sscribe_init|absint|setup_postdata|wp_reset_postdata|rawurlencode|wp_list_pluck|strip_shortcodes|wp_raise_memory_limit|number_format_i18n|get_user_by|FILTER_VALIDATE_IP|get_term|get_object_taxonomies|wp_convert_hr_to_bytes|wp_parse_url|maybe_unserialize|wp_get_current_user|wp_cache_delete|status_header|wp_is_writable|WP_Filesystem|request_filesystem_credentials|dbDelta|wp_trim_words|wp_rand|did_action|wp_count_posts) not found\.#'
        - '#Constant (SSCRIBE_VERSION|SSCRIBE_PLUGIN_DIR|SSCRIBE_PLUGIN_URL|SSCRIBE_PLUGIN_BASENAME|HOUR_IN_SECONDS|MINUTE_IN_SECONDS|DAY_IN_SECONDS|WEEK_IN_SECONDS|WP_DEBUG|WP_CONTENT_DIR|PREG_OFFSET_OFFSET|ARRAY_A|OBJECT|OBJECT_K) not found\.#'
        - '#Class (WP_Post|WP_Error|WP_User|WP_Query|WP_Filesystem_Base) not found\.#'
        - '#Call to method .* on an unknown class WP_Filesystem_Base\.#'
        - '#Property .* has unknown class WP_Filesystem_Base as its type\.#'
        - '#Instantiated class WP_Query not found\.#'
        - '#Access to property \$(posts|found_posts|max_num_pages) on an unknown class WP_Query\.#'
        - '#Function aioseo not found\.#'
        - '#Call to an undefined method DOMNode::#'
        - '#addCell\(\) expects int#'
        - '#array_map expects.*sanitize_text_field#'
        - '#array_map expects.*absint#'
        - '#If condition is always true\.#'
        - '#Ternary operator condition is always true\.#'
        - '#If condition is always false\.#'
        - '#Offset .* on array on left side of \?\? always exists#'
        - '#Offset .* on non-empty-array on left side of \?\? always exists#'
        - '#Offset .* on non-empty-list on left side of \?\? always exists#'
        - '#Strict comparison using === between mixed and#'
        - '#Property .* is never read, only written\.#'
        - '#Property .* does not accept null\.#'
        - '#Static method .* invoked with \d+ parameters, \d+ required\.#'
        - '#Unsafe usage of new static\(\)\.#'
        - '#Method .* has invalid return type WP_Error\.#'
        - '#Instantiated class WP_Error not found\.#'
        - '#Offset.*\$format.* on left side of \?\? always exists and is not nullable\.#'
        - '#Offset.* in isset\(\) always exists and is not nullable\.#'
        # Ignore unresolvable type errors from dynamically built arrays in usort/uasort/array_values/array_slice
        - '#contains unresolvable type\.$#'
        # Ignore boolean static analysis false positives in vendor dependency check (classes exist in CI but may not in production)
        - '#Right side of \|\| is always false\.#'
        - '#Negated boolean expression is always true\.#'
        - '#Function has_action not found\.#'
        # PHPStan cannot resolve private static self:: calls within same class (false positive).
        - '#Call to an undefined static method SScribe_Deactivator::cleanup_transients\(\)\.#'
