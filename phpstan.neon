parameters:
    level: 5
    paths:
        - includes
        - admin
        - sscribe-export-site-pages.php
    excludePaths:
        - vendor
    tmpDir: .cache/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Function (sanitize_text_field|esc_html|esc_attr|esc_url|esc_url_raw|wp_kses|wp_kses_post|wp_unslash|check_ajax_referer|current_user_can|get_option|update_option|delete_option|get_post|get_posts|get_permalink|get_the_title|get_the_content|apply_filters|do_action|add_action|add_filter|remove_action|remove_filter|plugin_dir_path|plugin_dir_url|plugin_basename|register_activation_hook|register_deactivation_hook|wp_upload_dir|wp_mkdir_p|wp_remote_get|wp_remote_retrieve_body|wp_remote_retrieve_response_code|is_wp_error|wp_json_encode|wp_send_json_success|wp_send_json_error|wp_verify_nonce|wp_create_nonce|admin_url|get_current_user_id|get_bloginfo|esc_html__|esc_attr__|__|_e|_x|_n|load_plugin_textdomain|is_admin|wp_doing_ajax|get_post_meta|get_post_type|get_post_type_object|is_rtl|wp_next_scheduled|wp_schedule_event|wp_clear_scheduled_hook|add_menu_page|add_submenu_page|add_management_page|wp_enqueue_style|wp_enqueue_script|wp_register_style|wp_register_script|plugins_url|remove_query_arg|add_query_arg|trailingslashit|untrailingslashit|wp_generate_password|set_transient|get_transient|delete_transient|sanitize_file_name|wp_die|wp_unschedule_event|current_time|wp_strip_all_tags|get_the_author_meta|get_post_thumbnail_id|wp_get_attachment_image_src|get_attached_file|get_the_date|get_the_modified_date|get_post_ancestors|home_url|get_children|date_i18n|size_format|wp_localize_script|checked|wp_delete_file|esc_html_e|wp_date|sscribe_init|absint|setup_postdata|wp_reset_postdata|rawurlencode|wp_list_pluck|strip_shortcodes) not found\.#'
        - '#Constant (SSCRIBE_VERSION|SSCRIBE_PLUGIN_DIR|SSCRIBE_PLUGIN_URL|SSCRIBE_PLUGIN_BASENAME|HOUR_IN_SECONDS|WP_DEBUG) not found\.#'
        - '#Class (WP_Post|WP_Error|WP_User|WP_Query) not found\.#'
        - '#Instantiated class WP_Query not found\.#'
        - '#Access to property \$(posts|found_posts) on an unknown class WP_Query\.#'
        - '#Function aioseo not found\.#'
        - '#Call to an undefined method DOMNode::#'
        - '#addCell\(\) expects int#'
