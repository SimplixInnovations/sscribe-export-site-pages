{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "includes"
        ],
        "excludes": [
            "vendor",
            "vendor-prefixed",
            "tests",
            "admin"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "infection.log",
        "html": "infection.html",
        "summary": "infection-summary.log"
    },
    "mutators": {
        "@default": true,
        "@function_signature": false,
        "@regex": false
    },
    "testFramework": "phpunit",
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 70,
    "minCoveredMsi": 80
}
