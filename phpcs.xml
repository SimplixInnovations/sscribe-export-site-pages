<?xml version="1.0"?>
<ruleset name="SScribe Export Site Pages">
    <description>WordPress coding standards for SScribe Export Site Pages plugin.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/.github/*</exclude-pattern>
    <exclude-pattern>/coverage/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/sscribe-exports/*</exclude-pattern>
    <exclude-pattern>/.cache/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="encoding" value="utf-8"/>

    <!-- Enforce full WordPress standard, exclude only with justification -->
    <rule ref="WordPress"/>
    
    <!-- Check PHP compatibility -->
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.2-"/>
    
    <!-- Allow PHP DOM property names (they're built-in camelCase) -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>*/includes/class-sscribe-content-parser\.php$</exclude-pattern>
    </rule>

    <!-- Allow direct DB queries in logging/audit/stats classes (intentional for performance) -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Allow interpolated variables in prepared statements for dynamic table names -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Allow placeholder mismatches in complex prepared queries -->
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Exclude pre-existing file with legacy formatting (305 CS errors from original codebase) -->
    <exclude-pattern>*/includes/class-sscribe-error\.php$</exclude-pattern>

    <!-- Exclude standalone CLI scripts that don't run inside WordPress -->
    <exclude-pattern>*/scripts/minify-css\.php$</exclude-pattern>
</ruleset>
