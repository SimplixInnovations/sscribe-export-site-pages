<?xml version="1.0"?>
<ruleset name="SScribe Export Site Pages">
    <description>WordPress coding standards for SScribe Export Site Pages plugin.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/vendor-prefixed/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/.github/*</exclude-pattern>
    <exclude-pattern>/coverage/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/sscribe-exports/*</exclude-pattern>
    <exclude-pattern>/WPScan/*</exclude-pattern>
    <exclude-pattern>/WordPress-Core/*</exclude-pattern>
    <exclude-pattern>/.cache/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="encoding" value="utf-8"/>
    <arg name="warning-severity" value="0"/>

    <!-- Enforce full WordPress standard, exclude only with justification -->
    <rule ref="WordPress"/>
    
    <!-- Check PHP compatibility -->
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.2-"/>
    
    <!-- Allow PHP DOM property names (they're built-in camelCase) -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>*/includes/class-sscribe-content-parser\.php$</exclude-pattern>
    </rule>

    <!-- Allow manual alias map spacing in vendor compatibility table -->
    <rule ref="WordPress.Arrays.MultipleStatementAlignment">
        <exclude-pattern>*/includes/sscribe-vendor-compat\.php$</exclude-pattern>
    </rule>

    <!-- Allow direct DB queries in logging/audit/stats classes (intentional for performance) -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Allow interpolated variables in prepared statements for dynamic table names -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Allow placeholder mismatches in complex prepared queries -->
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <exclude-pattern>*/includes/class-sscribe-audit-trail\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-export-stats\.php$</exclude-pattern>
        <exclude-pattern>*/includes/class-sscribe-logger-enhanced\.php$</exclude-pattern>
    </rule>

    <!-- Allow standalone CLI scripts that don't run inside WordPress -->
    <exclude-pattern>*/scripts/*</exclude-pattern>
    <exclude-pattern>*/scripts/build-release\.php$</exclude-pattern>
    <exclude-pattern>*/scripts/verify-zip\.php$</exclude-pattern>
    <exclude-pattern>*/scripts/list-zip\.php$</exclude-pattern>
    <exclude-pattern>*/scripts/check-wp-org\.php$</exclude-pattern>
    <exclude-pattern>*/scripts/fix-phpstan\.php$</exclude-pattern>
    <exclude-pattern>*/scripts/test-prefixed\.php$</exclude-pattern>

    <!-- Allow short ternaries (?:) — valid PHP 8.x pattern used throughout the codebase -->
    <rule ref="Universal.Operators.DisallowShortTernary.Found">
        <severity>0</severity>
    </rule>

    <!-- Suppress doc comment sniffs — intentionally removed during refactoring -->
    <rule ref="Squiz.Commenting.FileComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.ClassComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.VariableComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.InlineComment">
        <severity>0</severity>
    </rule>

    <!-- Allow all naming conventions for WP core properties and internal variables -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>*/includes/class-sscribe-batch-processor\.php$</exclude-pattern>
    </rule>
</ruleset>
