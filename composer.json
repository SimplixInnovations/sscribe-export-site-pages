{
    "name": "simplix-innovations/sscribe-export-site-pages",
    "description": "Export WordPress pages to professional DOCX, PDF, HTML, or Markdown packages with multilingual RTL support, SEO metadata, and secure ZIP downloads.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Simplix Innovations",
            "email": "info@simplixi.com",
            "homepage": "https://simplixi.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mpdf/mpdf": "~8.3.0",
        "phpoffice/phpword": "~1.4.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "automattic/vipwpcs": "^3.1.0",
        "brianhenryie/strauss": "~0.28.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4.1",
        "yoast/phpunit-polyfills": "^3.1.2"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "admin/"
        ],
        "exclude-from-classmap": [
            "/vendor/league/flysystem-local/",
            "/vendor/league/flysystem-memory/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/fix-phpword-style-deprecation.php"
        ],
        "post-update-cmd": [
            "@php scripts/fix-phpword-style-deprecation.php"
        ],
        "test": "phpunit --order-by=random",
        "test:coverage": "phpunit --coverage-html coverage/ --coverage-clover clover.xml",
        "test:coverage:check": "php scripts/verify-coverage-thresholds.php",
        "test:a11y": "php scripts/verify-accessibility.php",
        "test:perf": "php scripts/verify-performance-budget.php",
        "test:format-matrix": "php scripts/verify-format-matrix.php",
        "test:export-result": "php scripts/verify-export-result.php",
        "test:download-security": "php scripts/verify-download-security.php",
        "test:ajax-security": "php scripts/verify-ajax-security.php",
        "test:lifecycle": "php scripts/verify-lifecycle.php",
        "test:workflow-governance": "php scripts/verify-workflow-governance.php",
        "test:release-pipeline": "php scripts/verify-release-pipeline.php",
        "test:tag-policy": "php scripts/verify-tag-policy.php",
        "test:branch-protection": "php scripts/verify-branch-protection.php",
        "test:real-wp-matrix": "php scripts/verify-real-wp-matrix.php",
        "test:wpml-strategy": "php scripts/verify-wpml-strategy.php",
        "test:acceptance-matrix": "php scripts/verify-acceptance-matrix.php",
        "test:debug-log": "php scripts/verify-debug-log.php",
        "test:no-internal-details": "php scripts/verify-no-internal-details.php",
        "test:ci-docs": "php scripts/verify-ci-docs.php",
        "test:build-order": "php scripts/verify-build-order.php",
        "test:exact-package-clean-install": "php scripts/verify-exact-package-clean-install.php",
        "test:plugin-check-triage": "php scripts/verify-plugin-check-triage.php",
        "test:js-error-free": "php scripts/verify-js-error-free.php",
        "test:ajax-network-trace": "php scripts/verify-ajax-network-trace.php",
        "test:ui-refactor-discipline": "php scripts/verify-ui-refactor-discipline.php",
        "test:phase-68-test-coverage": "php scripts/verify-phase-68-test-coverage.php",
        "test:manual-runtime-tests": "php scripts/verify-manual-runtime-tests.php",
        "test:release-blockers": "php scripts/verify-release-blockers.php",
        "test:final-ci-state": "php scripts/verify-final-ci-state.php",
        "test:exact-artifact-evidence": "php scripts/verify-exact-artifact-evidence.php",
        "test:agent-final-report": "php scripts/verify-agent-final-report.php",
        "test:auditor-handoff": "php scripts/verify-auditor-handoff.php",
        "test:wp": "php -d extension=sqlite3 -d extension=pdo_sqlite -d memory_limit=1G vendor/bin/phpunit -c phpunit-wp.xml",
        "test:wp:install": "bash bin/install-wp-tests.sh --sqlite",
        "test:wp:uninstall": "bash bin/uninstall-wp-tests.sh",
        "test:all": "composer test && composer test:wp",
        "ci": "composer version:check && composer test && composer test:a11y && composer test:export-result && composer test:download-security && composer test:ajax-security && composer test:lifecycle && composer test:workflow-governance && composer test:release-pipeline && composer test:tag-policy && composer test:branch-protection && composer test:real-wp-matrix && composer test:wpml-strategy && composer test:acceptance-matrix && composer test:debug-log && composer test:no-internal-details && composer test:ci-docs && composer test:build-order && composer test:exact-package-clean-install && composer test:plugin-check-triage && composer test:js-error-free && composer test:ajax-network-trace && composer test:ui-refactor-discipline && composer test:phase-68-test-coverage && composer test:manual-runtime-tests && composer test:release-blockers && composer test:final-ci-state && composer test:exact-artifact-evidence && composer test:agent-final-report && composer test:auditor-handoff && composer i18n:check && composer stan && composer cs",
        "i18n:check": "php scripts/verify-i18n.php",
        "ci:full": "composer version:check && composer vendor:prefix && composer test && composer test:wp && composer test:a11y && composer i18n:check && composer stan && composer cs",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs -d memory_limit=512M --standard=phpcs.xml",
        "cs:fix": "phpcbf -d memory_limit=512M --standard=phpcs.xml",
        "i18n:make-pot": "WP_CLI_PHP_ARGS=\"-d memory_limit=1G\" $(which wp) i18n make-pot . languages/sscribe-export-site-pages.pot --domain=sscribe-export-site-pages --exclude=vendor,vendor-prefixed,node_modules,tests,scripts,.github,coverage,dist,build,.cache",
        "version:check": "php scripts/verify-version-sync.php",
        "vendor:prefix": "php -d memory_limit=512M -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_WARNING\" scripts/run-strauss.php && php -d memory_limit=512M scripts/fix-prefixed-safe.php && php scripts/fix-phpword-style-deprecation.php",
        "clean": "composer clean:cache && composer clean:coverage",
        "clean:cache": "php -r \"array_map('unlink', glob('.cache/**/*.*')); array_map('rmdir', glob('.cache/*', GLOB_ONLYDIR)); is_dir('.cache') && rmdir('.cache'); echo 'Cache cleared.\\n';\"",
        "clean:coverage": "php -r \"is_dir('coverage') && array_map('unlink', glob('coverage/*.*')) && rmdir('coverage'); echo 'Coverage cleared.\\n';\"",
        "release:prepare": "php scripts/release-prepare.php",
        "release:commit": "php scripts/release-commit.php",
        "release:full": "composer release:prepare && composer release:commit",
        "release:audit": "bash bin/release-audit.sh",
        "audit:npm": "npm audit --audit-level=high",
        "release": "php scripts/build-release.php",
        "full": "composer ci:full && composer release"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "SScribeVendor\\",
            "classmap_prefix": "SScribeVendor_",
	            "packages": [
                "mpdf/mpdf",
                "phpoffice/phpword",
                "psr/container"
            ],
            "delete_vendor_packages": false,
            "exclude_constants": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "platform-check": true,
        "process-timeout": 900,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
