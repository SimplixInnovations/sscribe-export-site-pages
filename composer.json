{
    "name": "simplix-innovations/sscribe-export-site-pages",
    "description": "Export every page into beautifully formatted Word DOCX files with multilingual support, SEO meta, rich styling, and secure ZIP download.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Simplix Innovations",
            "email": "info@simplixi.com",
            "homepage": "https://simplixi.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpoffice/phpword": "^1.4",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "automattic/vipwpcs": "^3.0"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "admin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SScribe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs -d memory_limit=512M --standard=phpcs.xml",
        "cs:fix": "phpcbf -d memory_limit=512M --standard=phpcs.xml",
        "css:minify": "php -r \"$css=preg_replace('/\\/\\*[^*]*\\*+(?:[^*\\/][^*]*\\*+)*\\//','',file_get_contents('admin/css/sscribe-admin.css'));$css=preg_replace('/\\s+/',' ',$css);$css=preg_replace('/\\s*([{};:,>~+])\\s*/','$1',$css);$css=preg_replace('/;}/','}',$css);file_put_contents('admin/css/sscribe-admin.min.css',trim($css));\"",
        "version:check": "php scripts/verify-version-sync.php",
        "clean": "composer clean:cache && composer clean:coverage",
        "clean:cache": "php -r \"array_map('unlink', glob('.cache/**/*.*')); array_map('rmdir', glob('.cache/*', GLOB_ONLYDIR)); is_dir('.cache') && rmdir('.cache'); echo 'Cache cleared.\\n';\"",
        "clean:coverage": "php -r \"is_dir('coverage') && array_map('unlink', glob('coverage/*.*')) && rmdir('coverage'); echo 'Coverage cleared.\\n';\"",
        "ci": "composer version:check && composer test && composer stan && composer cs",
        "build": "composer css:minify"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
