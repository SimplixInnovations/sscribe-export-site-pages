{
    "name": "simplix-innovations/sscribe-export-site-pages",
    "description": "Export WordPress pages to professional DOCX, PDF, HTML, or Markdown packages with multilingual RTL support, SEO metadata, and secure ZIP downloads.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Simplix Innovations",
            "email": "info@simplixi.com",
            "homepage": "https://simplixi.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mpdf/mpdf": "~8.3.0",
        "phpoffice/phpword": "~1.4.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "brianhenryie/strauss": "~0.28.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4.1",
        "automattic/vipwpcs": "^3.1.0"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "admin/"
        ],
        "exclude-from-classmap": [
            "/vendor/league/flysystem-local/",
            "/vendor/league/flysystem-memory/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/fix-phpword-style-deprecation.php"
        ],
        "post-update-cmd": [
            "@php scripts/fix-phpword-style-deprecation.php"
        ],
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs -d memory_limit=512M --standard=phpcs.xml",
        "cs:fix": "phpcbf -d memory_limit=512M --standard=phpcs.xml",
        "i18n:make-pot": "wp i18n make-pot . languages/sscribe-export-site-pages.pot --domain=sscribe-export-site-pages --exclude=vendor,vendor-prefixed,node_modules,tests,scripts,.github,coverage,dist,build,.cache",
        "version:check": "php scripts/verify-version-sync.php",
        "vendor:prefix": "php -d memory_limit=512M -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_WARNING\" scripts/run-strauss.php && php -d memory_limit=512M scripts/fix-prefixed-safe.php && php scripts/fix-phpword-style-deprecation.php",
        "clean": "composer clean:cache && composer clean:coverage",
        "clean:cache": "php -r \"array_map('unlink', glob('.cache/**/*.*')); array_map('rmdir', glob('.cache/*', GLOB_ONLYDIR)); is_dir('.cache') && rmdir('.cache'); echo 'Cache cleared.\\n';\"",
        "clean:coverage": "php -r \"is_dir('coverage') && array_map('unlink', glob('coverage/*.*')) && rmdir('coverage'); echo 'Coverage cleared.\\n';\"",
        "ci": "composer version:check && composer test && composer stan && composer cs",
        "ci:full": "composer version:check && composer vendor:prefix && composer test && composer stan && composer cs",
        "release:prepare": "php scripts/release-prepare.php",
        "release:commit": "php scripts/release-commit.php",
        "release:full": "composer release:prepare && composer release:commit",
        "release": "php scripts/build-release.php",
        "full": "composer ci:full && composer release"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "SScribeVendor\\",
            "classmap_prefix": "SScribeVendor_",
	            "packages": [
                "mpdf/mpdf",
                "phpoffice/phpword",
                "psr/container"
            ],
            "delete_vendor_packages": false,
            "exclude_constants": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true,
        "process-timeout": 900,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
