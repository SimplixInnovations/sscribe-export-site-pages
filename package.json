{
	"name": "sscribe-export-site-pages",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Export WordPress pages to professional DOCX, PDF, HTML, or Markdown packages",
	"scripts": {
		"lint:js": "eslint admin/js/*.js",
		"lint:css": "stylelint admin/css/*.css",
		"lint": "npm run lint:js && npm run lint:css",
		"format": "prettier --write \"admin/**/*.{js,css,json}\"",
		"format:check": "prettier --check \"admin/**/*.{js,css,json}\""
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@wp-playground/cli": "^3.1.44",
		"csso-cli": "^4.0.2",
		"eslint": "^10.9.1",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^7.0.2"
	}
}
