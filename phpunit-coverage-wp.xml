<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for the real WordPress integration coverage
  suite emitting serialized coverage data to dist/coverage-data/wp.cov.

  See scripts/merge-coverage.php for how this file is consumed.

  failOnRisky / failOnWarning are deliberately OFF in the coverage
  pipeline. The dedicated `composer test:wp` CI job runs the same
  suite under phpunit-wp.xml with failOn* ON, so test-quality gates
  are still enforced there. Under xdebug coverage on Linux PHPUnit
  11 reports a benign "headers already sent" runtime warning from
  SScribe_Admin_Debug (its header() calls race PHPUnit progress
  output when the AJAX endpoints are dispatched) plus a handful of
  risky markers caused by tests that emit side-channel output — both
  of which would short-circuit coverage collection if failOn* were ON,
  leaving the merge step with no wp.cov file and the canonical
  coverage gate unable to measure the production modules the WP suite
  is the only thing that exercises.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    bootstrap="tests-wp/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    failOnRisky="false"
    failOnWarning="false"
>
    <testsuites>
        <testsuite name="WordPress">
            <directory suffix="Test.php">tests-wp/WordPress</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">admin</directory>
        </include>
        <exclude>
            <file>includes/class-sscribe-activator.php</file>
            <file>includes/class-sscribe-deactivator.php</file>
        </exclude>
    </source>

    <php>
        <env name="WP_TESTS_DIR" value="tests-wp/_wordpress-tests-lib"/>
        <env name="WP_CORE_DIR" value="tests-wp/_wordpress"/>
        <env name="WP_PHP_BINARY" value="php tests-wp/wp-php-wrapper.php"/>
        <ini name="memory_limit" value="1024M"/>
    </php>

    <coverage>
        <report>
            <php outputFile="dist/coverage-data/wp.cov"/>
        </report>
    </coverage>
</phpunit>
