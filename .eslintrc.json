{
  "env": {
    "browser": true,
    "jquery": true,
    "es2024": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "sscribe_data": "readonly",
    "SScribe": "readonly",
    "$": "readonly",
    "jQuery": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "eqeqeq": ["error", "smart"],
    "curly": ["error", "all"],
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "no-var": "warn",
    "prefer-const": "error"
  }
}
