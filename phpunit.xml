<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    failOnRisky="true"
    failOnWarning="true"
    requireCoverageMetadata="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
        <testsuite name="Security">
            <directory suffix="Test.php">tests/Security</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">admin</directory>
        </include>
        <exclude>
            <file>includes/class-sscribe-activator.php</file>
            <file>includes/class-sscribe-deactivator.php</file>
        </exclude>
    </source>

    <!--
        Phase 41: Coverage gate.

        When the test runner executes with a coverage driver (Xdebug /
        PCOV), PHPUnit writes a Clover XML report to `clover.xml`. The
        external verifier `scripts/verify-coverage-thresholds.php`
        then enforces two contracts:

          (a) project-wide line-coverage threshold of 70%;
          (b) per-file coverage threshold of 90% for the four
              security-critical modules — the private storage
              boundary, the filesystem containment surface, the
              security validator, and the audit trail writer.

        PHPUnit's own `<coverage>` element does not enforce minimum
        percentages; the contract lives in the verifier so the same
        rules apply to local runs and CI.

        `requireCoverageMetadata="false"` on the root `<phpunit>`
        element keeps tests that lack a `@covers` annotation from
        being marked risky when a coverage driver is active.
    -->
    <coverage>
        <report>
            <clover outputFile="clover.xml"/>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
</phpunit>
